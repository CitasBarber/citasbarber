# URL pública del frontend (usada en links y mensajes)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Conexión a MongoDB.
# - Si se deja VACÍA en desarrollo, la app arranca automáticamente un
#   MongoDB en memoria (mongodb-memory-server). No necesitas instalar nada.
# - En producción (Vercel) usa tu cadena de MongoDB Atlas:
#   mongodb+srv://usuario:clave@cluster0.mongodb.net/citasbarber
MONGODB_URI=

# Secret para firmar los tokens JWT. OBLIGATORIO en producción (la app no
# arranca sin él). Genera uno fuerte con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión en segundos (por defecto 172800 = 2 días).
JWT_EXPIRES_IN=172800

# Credenciales del administrador inicial.
# SOLO se usan por el seed en DESARROLLO. En producción el seed NO corre;
# crea el admin con: node scripts/crear-admin.mjs (contraseña de 12+ caracteres).
ADMIN_EMAIL=admin@citasbarber.com
ADMIN_PASSWORD=Admin123*

# Poner en "false" para desactivar el seed automático incluso en desarrollo.
# ALLOW_SEED=false

# Notificaciones Web Push (VAPID). Genera un par de claves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La clave pública va DOS veces: VAPID_PUBLIC_KEY (servidor) y
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (cliente, debe ser idéntica).
# VAPID_SUBJECT es un mailto: de contacto. Sin estas variables, las
# notificaciones quedan simplemente desactivadas (la app sigue funcionando).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tudominio.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secreto para el endpoint de recordatorios (/api/cron/recordatorios). Un cron
# externo (p. ej. cron-job.org) debe llamarlo cada pocos minutos enviando el
# header:  Authorization: Bearer <CRON_SECRET>. Sin este valor el endpoint
# responde 500 y no envía nada. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
